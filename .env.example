# Copy to .env and adjust. .env is gitignored — never commit real keys.

# "mock" (default, no API calls) or "openrouter"
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Set by docker-compose; override only for local (non-Docker) runs
# DATABASE_PATH=./data/cookwithai.db
